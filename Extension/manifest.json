{
  "manifest_version": 3,
  "key": "",
  "name": "PhishCatcher",
  "description": "Base Level Extension",
  "version": "1.0",
  "action": {
    "default_popup": "hello.html",
    "default_icon": "fish.png"
  },
  "icons": {
    "128": "fish.png"
  },
  "permissions": [
    "identity",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "oauth2": {
    "client_id": "284386632337-no066nve6okfp42brciil5e4uqqa6d2r.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}